# ==============================================================================
# LADIES GOLF ASSOCIATION OF NIGERIA (LGAN) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# For local development or hosted PostgreSQL (Supabase, Neon, Railway, AWS RDS):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lgan_db?schema=public"

# ------------------------------------------------------------------------------
# 2. PAYSTACK PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain these from your Paystack Dashboard (https://dashboard.paystack.com/#/settings/developer)
# Use "pk_test_..." and "sk_test_..." during staging/testing, and "pk_live_..." in production.

# Public Key: Used by the frontend Paystack checkout modal (Card/Transfer/USSD)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_aact2026_lgan_digital_gateway"

# Secret Key: Used by Next.js server route handlers to verify transactions & handle payouts
PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"

# Webhook Secret: Used to authenticate webhooks from Paystack
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret_here"

# ------------------------------------------------------------------------------
# 3. APPLICATION URL & SECRETS
# ------------------------------------------------------------------------------
# Base domain of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret string used for cryptographic signing of member tokens and session cookies
NEXTAUTH_SECRET="lgan_enterprise_super_secret_key_change_in_production_2026"
